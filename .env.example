# Default demo mode uses the in-memory mock adapter.
# For the real Supabase adapter, set VITE_USE_MOCK=false and fill in the URL and
# publishable/anon key. Never add a service-role key to a Vite variable.
VITE_USE_MOCK=true
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=

# Test-only. Never expose the service role key in client code.
# SUPABASE_DB_URL=
# SUPABASE_SERVICE_ROLE_KEY=
